# ---- Ontario Playground Finder — environment configuration ----
# Copy to .env and fill in. See MANUAL_SETUP.md for every value.
# This file is loaded automatically at startup; variables already set in the
# process environment (shell exports, host dashboard) take precedence over it.

# REQUIRED before going live -------------------------------------------------
# Generate SECRET_KEY with e.g.:  openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string
# Moderator sign-in password (admin login is refused while this is empty):
ADMIN_PASSWORD=

# Database (default: local SQLite file, zero setup) ---------------------------
# DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/playgrounds

# Uploads ----------------------------------------------------------------------
# UPLOAD_DIR=./data/uploads
# MAX_PHOTOS_PER_SUBMISSION=10
# MAX_UPLOAD_BYTES=15728640
# IMAGE_MAX_DIMENSION=1600
# IMAGE_QUALITY=80

# Map tiles (default: OpenStreetMap — see usage policy in MANUAL_SETUP.md) -----
# TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Address search (default: public Nominatim; rate-limited) ---------------------
# GEOCODER_ENABLED=true
# GEOCODER_URL=https://nominatim.openstreetmap.org/search

# Map start view ----------------------------------------------------------------
# MAP_START_LAT=43.85
# MAP_START_LNG=-79.55
# MAP_START_ZOOM=8

# Anti-abuse ----------------------------------------------------------------------
# SUBMISSIONS_PER_HOUR_PER_IP=10
